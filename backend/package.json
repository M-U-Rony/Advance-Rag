{
  "name": "advance-rag-backend",
  "version": "1.0.0",
  "description": "Advanced RAG over PDFs: hybrid search, reranking, query transformation, parent-child chunking and a full pipeline trace.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/evaluation/runEval.ts",
    "models": "tsx src/downloadModels.ts",
    "sample-pdf": "tsx scripts/generateSamplePdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@huggingface/transformers": "^4.3.2",
    "fastify": "^5.12.8",
    "openai": "^7.64.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.6",
    "@types/pdfkit": "^0.17.7",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pdfkit": "^0.21.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
