# ---------------------------------------------------------------------------
# Advance RAG configuration. Copy to `.env` and edit. Every variable is optional:
# with no LLM key the app runs fully offline using an extractive answerer.
# ---------------------------------------------------------------------------

# LLM provider: none | openai | openai_compatible | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Recommended free option: Groq (https://console.groq.com) ---------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# --- OpenAI ------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Google Gemini (OpenAI-compatible endpoint) -------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=...

# --- Ollama (local, no key needed) ----------------------------------------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# (inside Docker use http://host.docker.internal:11434/v1)

# --- Anthropic -----------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# LLM_API_KEY=sk-ant-...

# Embeddings: auto (bge-small if it can be loaded, else TF-IDF) | dense | tfidf
EMBEDDING_BACKEND=auto
# ONNX export used by Transformers.js (a BAAI/<name> id is mapped to Xenova/<name> automatically)
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Cross-encoder used by the "cross_encoder" reranker (falls back to a heuristic reranker)
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Model weight precision: fp32 (exact) | fp16 | q8 (about 4x smaller and faster, slightly less exact)
MODEL_DTYPE=fp32
# Where downloaded models are cached (default: <DATA_DIR>/models)
MODEL_CACHE_DIR=

# Where documents, chunks and cached vectors are stored
DATA_DIR=./data
# Comma separated list of allowed CORS origins (only needed for a separate frontend host)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
# HTTP server
PORT=8000
HOST=0.0.0.0
